  <registry id="integrity-protection-methods">
    <title>IOAM Integrity Protection Methods</title>
    <xref type="draft" data="RFC-ietf-ippm-ioam-data-integrity-20"/>
    <registration_rule>IETF Review</registration_rule>
    <note>When this registry is modified, the YANG module <xref type="registry" data="iana-ioam-integrity-protection-methods">iana-ioam-integrity-protection-methods</xref> 
must be updated as defined in <xref type="draft" data="RFC-ietf-ippm-ioam-integrity-yang-08"/>.
    </note>
    <record date="2026-07-31">
      <value>0x00</value>
      <description>AES-GMAC, 16-octet (full) Authentication Tag, 12-octet Initialization Vector.</description>
      <header>Pre-allocated Trace and Incremental Trace:<br/>
      - Namespace-ID (mask = 0xffff)<br/>
      - NodeLen + Flags + RemainingLen (mask = 0xfb00)<br/>
      - IOAM Trace-Type (mask = 0xffffff)<br/>
      - Reserved (mask = 0x00)<br/>
      <br/>

      POT:<br/>
      - Namespace-ID (mask = 0xffff)<br/>
      - IOAM-POT-Type (mask = 0xff)<br/>
      - IOAM-POT-Flags (mask = 0x00)<br/>
      <br/>

      E2E:<br/>
      - Namespace-ID (mask = 0xffff)<br/>
      - IOAM-E2E-Type (mask = 0xffff)<br/>
    </header>
      <xref type="draft" data="RFC-ietf-ippm-ioam-data-integrity-20" section="5">RFC-ietf-ippm-ioam-data-integrity-20, Section 5</xref>
    </record>
    <record>
      <value>0x01-0xFE</value>
      <description>Unassigned</description>
      <header/>
    </record>
    <record date="2026-07-31">
      <value>0xFF</value>
      <description>Reserved</description>
      <header/>
      <xref type="draft" data="RFC-ietf-ippm-ioam-data-integrity-20"/>
    </record>
